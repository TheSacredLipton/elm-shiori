{
  "name": "elm-shiori",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSacredLipton/elm-shiori.git"
  },
  "keywords": ["elm-shiori", "shiori"],
  "author": "TheSacredLipton",
  "version": "0.4.2",
  "description": "Elm UI Viewer",
  "license": "MIT",
  "bin": {
    "shiori": "bin/shiori.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.0",
    "@playwright/test": "^1.61.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "@types/yargs": "^17.0.32",
    "elm": "0.19.1-6",
    "elm-test": "0.19.1-revision10",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.4",
    "chokidar": "^3.6.0",
    "elm-review": "^2.12.0",
    "fs-extra": "^10.1.0",
    "hono": "^4.4.7",
    "immer": "^9.0.21",
    "kleur": "^4.1.5",
    "node-elm-compiler": "^5.0.6",
    "ws": "^8.17.0",
    "yargs": "^17.7.2"
  },
  "scripts": {
    "start": "node --watch dev.js",
    "test": "biome ci . && tsc -p jsconfig.json --noEmit && elm-test && node --test",
    "test:vrt": "playwright test",
    "test:vrt:update": "playwright test --update-snapshots",
    "biome-apply": "biome check . --apply",
    "npm-publish": "npm run test && npm run test:vrt && npm publish"
  },
  "type": "module"
}
